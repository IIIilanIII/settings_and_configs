{
  // =====================================================================
  // RIGOROUS HIGH-CONTRAST LIGHT THEME (APCA Compliant)
  // - Background: Crisp Off-White Paper (#F9FAFB)
  // - Main Text / Boilerplate: Deep Obsidian Charcoal (#111827) [Lc ~95]
  // - Control Keywords: Deep Cyan-Teal (#0E7490) [Lc ~74]
  // - Functions / Calls: Deep Royal Blue (#1D4ED8) [Lc ~72]
  // - Types / Classes: Deep Muted Purple (#6B21A8) [Lc ~68]
  // - Strings / Literals: Deep Forest Emerald (#047857) [Lc ~70]
  // - Comments: Slate Gray (#4B5563) [Lc ~60]
  // =====================================================================
  "editor.fontFamily": "'Atkinson Hyperlegible Mono', 'Cascadia Mono', 'SF Mono', Menlo, Consolas, monospace",
  "editor.fontSize": 18,
  "editor.fontWeight": "400",
  "editor.lineHeight": 1.5,
  "editor.letterSpacing": 0.3,
  "editor.fontLigatures": "'calt', 'liga', 'zero'",
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.minimap.enabled": false,
  "editor.renderWhitespace": "selection",
  "editor.stickyScroll.enabled": true,
  "editor.guides.indentation": false,
  "editor.formatOnSave": true,
  "editor.smoothScrolling": true,
  "editor.inlineSuggest.enabled": false,
  "editor.cursorBlinking": "solid",
  "editor.cursorWidth": 2,
  "editor.bracketPairColorization.enabled": false,
  "editor.guides.bracketPairs": "false",
  "editor.matchBrackets": "always",
  "workbench.colorTheme": "Alabaster",
  "editor.lineNumbers": "off",
  "search.showLineNumbers": true,
  // --- KEEP THE MARGIN COLUMN STRUCTURALLY, BUT LEAVE IT EMPTY ---
  // Keeps the margin column space reserved so layout doesn't collapse
  "editor.glyphMargin": false,
  // Hides Git change ticks from appearing in the margin/gutter
  "scm.diffDecorations": "gutter", // Wait, set to "none" to completely clear them out:
  "scm.diffDecorations": "none",
  // Prevents breakpoints and debug icons from cluttering the left margin
  "debug.showBreakpointsInOverviewRuler": false,
  // Hides error/warning marker icons from the margin (while keeping underline squiggles in code)
  "editor.lightbulb.enabled": "off",
  // Automatically wraps text when it hits the limit
  // "bounded" wraps at the 80-column mark, but will also shrink if your window is narrower than 80 chars
  "editor.wordWrap": "bounded",
  "editor.wordWrapColumn": 100,
  // --- OPTIMIZED REDHAT / ECLIPSE JAVA FORMATTER SETTINGS ---
  "[java]": {
    "editor.defaultFormatter": "redhat.java",
    "editor.formatOnSave": true
  },
  "java.format.settings.url": ".vscode/formatter.xml",
  "java.format.settings.profile": "Ergonomic-Java-100",
  "workbench.iconTheme": "vs-minimal",
  "workbench.colorCustomizations": {
    "editor.background": "#fbf7f0",
    "editor.foreground": "#3B3B3B"
  }
}
